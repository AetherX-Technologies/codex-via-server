{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AetherX-Technologies/codex-via-server/schemas/connection-profile.schema.json",
  "title": "Codex via Server approved connection profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "server",
    "gateway",
    "client",
    "approved_device",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "ssh_port", "ssh_user", "host_fingerprints"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^(?:100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){1,6})$"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ssh_user": {
          "type": "string",
          "const": "codex-tunnel"
        },
        "host_fingerprints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_host", "remote_port"],
      "properties": {
        "remote_host": {
          "type": "string",
          "const": "127.0.0.1"
        },
        "remote_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_port",
        "codex_profile",
        "minimum_client_version",
        "minimum_codex_version"
      ],
      "properties": {
        "local_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "codex_profile": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "minimum_client_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "minimum_codex_version": {
          "$ref": "#/$defs/semantic_version"
        }
      }
    },
    "approved_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "public_key_fingerprint"],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
        },
        "public_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
